{
  "version": 3,
  "name": "SocioUnido API Gateway",
  "port": 8080,
  "timeout": "3000ms",
  "cache_ttl": "300s",
  "extra_config": {
    "security/cors": {
      "allow_origins": [
        "{{ env `FRONTEND_URL` }}",
        "{{ env `APP_FRONTEND_URL` }}",
        "{{ env `APP_FRONTEND2_URL` }}",
        "{{ env `APP_FRONTEND3_URL` }}",
        "{{ env `APP_FRONTEND4_URL` }}",
        "{{ env `APP_FRONTEND5_URL` }}",
        "{{ env `APP_FRONTEND6_URL` }}",
        "{{ env `APP_FRONTEND7_URL` }}",
        "http://localhost:3000",
        "http://localhost:5137",
        "http://localhost:5138"
      ],
      "allow_methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH"],
      "allow_headers": ["Origin", "Authorization", "Content-Type"],
      "expose_headers": ["Content-Length"],
      "max_age": "12h"
    }
  },
  "endpoints": [
    {{ template "club.tmpl" . }},
    {{ template "auth.tmpl" . }},
    {{ template "analiticas.tmpl" . }},
    {{ template "pagos.tmpl" . }},
    {{ template "accesos.tmpl" . }}
  ]
}
