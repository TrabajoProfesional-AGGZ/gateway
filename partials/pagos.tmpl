        "extra_config": {
        "modifier/martian": {
            "header.Modifier": {
            "scope": ["request"],
            "name": "X-Internal-Secret",
            "value": "{{ env `INTERNAL_SECRET_TOKEN` }}"
            }
        }
        }
    }
    ]
},
