{{ define "pagos.tmpl" }}
{
    "endpoint": "/api/v1/docs/pagos",
    "method": "GET",
    "output_encoding": "no-op",
    "backend": [
    {
        "url_pattern": "/docs",
        "encoding": "no-op",
        "sd": "static",
        "method": "GET",
        "host": ["{{ env `MS_PAGOS_URL` }}"]
    }
    ]
},
{
    "endpoint": "/api/v1/openapi/pagos.json",
    "method": "GET",
    "output_encoding": "no-op",
    "backend": [
    {
        "url_pattern": "/api/v1/openapi/pagos.json",
        "encoding": "no-op",
        "sd": "static",
        "method": "GET",
        "host": ["{{ env `MS_PAGOS_URL` }}"]
    }
    ]
},    
{
    "endpoint": "/api/v1/analiticas/fidelizacion",
    "method": "GET",
    "output_encoding": "no-op",
    "extra_config": {
    "auth/validator": {
        "alg": "RS256",
        "jwk_url": "https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com",
        "issuer": "https://securetoken.google.com/{{ env `FIREBASE_PROJECT_ID` }}",
        "audience": ["{{ env `FIREBASE_PROJECT_ID` }}"],
        "disable_jwk_security": true
    }
    },
    "backend": [
    {
        "url_pattern": "/api/v1/analiticas/fidelizacion",
        "encoding": "no-op",
        "sd": "static",
        "method": "GET",
        "host": ["{{ env `MS_ANALITICAS_URL` }}"],
        "extra_config": {
        "modifier/martian": {
            "header.Modifier": {
            "scope": ["request"],
            "name": "X-Internal-Secret",
            "value": "{{ env `INTERNAL_SECRET_TOKEN` }}"
            }
        }
        }
    }
    ]
},
{
    "endpoint": "/api/v1/pagos/health",
